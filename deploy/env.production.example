# ───────────────────────────────────────────────────────────
# 信逢 Inkling · 生产环境变量模板
# 用法：在仓库根目录 `cp deploy/env.production.example .env`，填完所有 CHANGE_ME。
# 注意：.env 已被 .gitignore 忽略，切勿提交。容器编排与 API 运行时共用本文件。
# 运行：docker compose -f deploy/docker-compose.prod.yml --env-file .env up -d --build
# ───────────────────────────────────────────────────────────

# ── Caddy 边缘 ──
# 正式域名（Caddy 自动签发 HTTPS）；无域名本机联测可填 :80
SITE_ADDRESS=inkling.example.com

# ── PostgreSQL（compose 起容器用，供 ${} 插值） ──
POSTGRES_USER=inkling
# 仅用字母数字（会被编排拼进 DATABASE_URL，避免 @ : / 等 URL 保留字符）
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
POSTGRES_DB=inkling

# ── API 运行时：数据库 / Redis ──
# 连接串由 deploy/docker-compose.prod.yml 自动生成（host=服务名 postgres/redis），无需手填；
# compose 插值只依赖上方 POSTGRES_*。

# ── 认证 ──
# ⚠️ 务必强随机：openssl rand -base64 48
JWT_SECRET="CHANGE_ME_use_openssl_rand_base64_48"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# ── 后端服务 ──
API_PORT=3001
# CORS 放行来源；同源反代下浏览器不触发 CORS，仅直连 API 时生效
WEB_ORIGIN="https://inkling.example.com"

# ── 前端（构建期已固化进 web 镜像，此处仅备注；改值需重建 web 镜像） ──
# NUXT_PUBLIC_API_BASE=/v1     （同源，Caddy 反代）
# NUXT_PUBLIC_USE_MOCK=0       （生产构建已自动关闭 Mock；切勿设为 1）

# ── 慢社交节奏参数 ──
QUOTA_DAILY_SEND=1
QUOTA_DAILY_FISH=3
QUOTA_DAILY_UNSEAL=1
PREVIEW_LOCK_SECONDS=600
REPLY_WINDOW_DAYS=7
LETTER_MAX_DRIFT_DAYS=30
LETTER_MAX_RECYCLE=3
LETTER_POOL_DELAY_SECONDS=30
# 生产必须为 1：真实 4–96h 距离精算。设 0 会让笔友信秒到，破坏慢节奏！
DELIVERY_HOURS_SCALE=1

# ── 限流（防爆破 / 粗粒度 DoS 兜底；按 IP×路由 计数，反代后取真实 IP） ──
# 窗口毫秒 / 窗口内全局上限。注意：多用户可能共用一个出口 IP（校园/公司 NAT），
# 全局上限不宜太低；auth 端点已在代码内单独收紧到 8/分钟。
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=300
# 生产切勿设为 1（=关闭限流）。留空即启用。
# THROTTLE_DISABLED=0

# ── 内容审核（local=本地规则；remote=第三方多语种 API，C 档接入） ──
MODERATION_PROVIDER="local"
# MODERATION_API_URL=""
# MODERATION_API_KEY=""
