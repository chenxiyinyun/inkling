# 信逢 Inkling · 边缘反向代理 + 静态托管
# SITE_ADDRESS 由环境变量注入：
#   - 正式域名（如 inkling.example.com）→ Caddy 自动签发并续期 HTTPS 证书
#   - 本机 / 无域名联测 → 设为 :80（明文，仅用于验证编排）
{$SITE_ADDRESS} {
	encode zstd gzip

	log {
		output stdout
		format json
	}

	# 基础安全响应头（HSTS 仅在 HTTPS 下被浏览器采纳）
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		# CSP：Nuxt SPA 需要内联脚本/样式；其余资源一律同源（/v1 同源反代，connect-src 'self' 即可）
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
	}

	# ⚠️ 必须用互斥 handle 块分隔 API 与 SPA：
	# Caddy 默认指令顺序中 try_files 先于 reverse_proxy。若裸写 `try_files {path} /index.html`
	# 会把 /v1/*（磁盘上不存在）重写为 /index.html，随后 @api 路径匹配器失效、
	# reverse_proxy 被跳过，file_server 返回前端 HTML —— API 全部不可达。
	handle /v1/* {
		reverse_proxy api:3001
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
