{
  "name": "inkling",
  "version": "0.1.0",
  "private": true,
  "description": "信逢 · Inkling — 一座漂流邮局，让社交回归真诚与纯粹",
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @inkling/api dev",
    "dev:web": "pnpm --filter @inkling/web dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm --filter @inkling/shared build",
    "db:generate": "pnpm --filter @inkling/api prisma:generate",
    "db:migrate": "pnpm --filter @inkling/api prisma:migrate",
    "db:seed": "pnpm --filter @inkling/api prisma:seed",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma",
      "vue-demi"
    ]
  }
}
