# ───────────────────────────────────────────────────────────
# 信逢 Inkling · 环境变量示例
# 复制为 .env 后按需修改。后端读取根目录 .env。
# ───────────────────────────────────────────────────────────

# --- 数据库 (PostgreSQL 16) ---
DATABASE_URL="postgresql://inkling:inkling@localhost:5432/inkling?schema=public"

# --- Redis (配额 / 分布式锁 / 计数) ---
REDIS_URL="redis://localhost:6379"

# --- 认证 ---
JWT_SECRET="change-me-in-production-please-use-a-long-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# --- 后端服务 ---
API_PORT=3001
# 允许的前端来源 (CORS)
WEB_ORIGIN="http://localhost:3000"

# --- 前端 (Nuxt 运行时) ---
NUXT_PUBLIC_API_BASE="http://localhost:3001/v1"

# --- 慢社交节奏参数 (可调；详见 docs/产品设计文档.md) ---
# 每日配额
QUOTA_DAILY_SEND=1
QUOTA_DAILY_FISH=3
QUOTA_DAILY_UNSEAL=1
# 预览锁时长 (秒)
PREVIEW_LOCK_SECONDS=600
# 回信窗口 (天)
REPLY_WINDOW_DAYS=7
# 信件漂流上限 (天) / 最大回池次数
LETTER_MAX_DRIFT_DAYS=30
LETTER_MAX_RECYCLE=3
# 信件入海延迟 (秒)；信件入海无收件人、距离未知，用固定短延时
LETTER_POOL_DELAY_SECONDS=30
# 笔友往来在途时长缩放因子：在途 = pickDeliveryTier(距离).baseHours × scale。
# prod=1（真实 4–96h）；本地想快可设小数；集成测试设 0 即时验证
DELIVERY_HOURS_SCALE=1

# --- 内容审核 (local=本地规则默认；remote=第三方多语种 API，C 档接入) ---
MODERATION_PROVIDER="local"
# MODERATION_API_URL=""
# MODERATION_API_KEY=""

# --- 未成年人保护 / 合规 ---
# 低于此年龄直接婉拒 (各地法定最低；详见 docs/合规与本地化-海外.md)
MIN_AGE_HARD_FLOOR=13
# 低于此年龄进入守护模式
GUARDIAN_MODE_BELOW_AGE=18
